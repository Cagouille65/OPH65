# COPIEZ / ADAPTEZ ce contenu dans :
# Streamlit Community Cloud > votre App > Settings > Secrets
# NE METTEZ JAMAIS vos vraies clés dans GitHub.

[app]
cloud_mode = true
public_base_url = "https://VOTRE-APP.streamlit.app"
# Protège le tableau de bord. Les QR de validation restent publics.
access_password = "CHOISISSEZ_UN_MOT_DE_PASSE_SOLIDE"
# Reçoit automatiquement les confirmations de fin de prestation.
rts_email = "responsable@oph65.fr"

[supabase]
url = "https://VOTRE-PROJET.supabase.co"
# Utiliser la clé serveur secrète (sb_secret_...) depuis le dialogue Connect / API Keys.
# La clé legacy service_role reste acceptée par le code, mais Supabase recommande désormais les Secret keys.
secret_key = "sb_secret_VOTRE_CLE"

[smtp]
server = "smtp.gmail.com"
port = 465
use_ssl = true
auth_required = true
use_starttls = false
email = "VOTRE_ADRESSE@EXEMPLE.FR"
password = "VOTRE_MOT_DE_PASSE_APPLICATION"
default_recipients = ""
